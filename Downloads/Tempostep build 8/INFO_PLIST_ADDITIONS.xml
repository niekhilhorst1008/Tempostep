<!-- 
  ⚠️ COPY THIS ENTIRE BLOCK TO YOUR Info.plist
  
  Location: ios/App/App/Info.plist
  
  How to add:
  1. Open Xcode → App/App/Info.plist
  2. Right-click → "Open As" → "Source Code"
  3. Find </dict> near the bottom
  4. Paste this BEFORE the closing </dict>
  5. Replace YOUR_ADMOB_APP_ID with actual ID from Google AdMob
-->

<!-- 
  ═══════════════════════════════════════════════
  SECTION 1: GOOGLE ADMOB CONFIGURATION
  ═══════════════════════════════════════════════
-->

<!-- AdMob App ID - REQUIRED or app will crash -->
<key>GADApplicationIdentifier</key>
<string>ca-app-pub-YOUR_PUBLISHER_ID~YOUR_APP_ID</string>
<!-- Example: ca-app-pub-3940256099942544~1458002511 -->

<!-- 
  ═══════════════════════════════════════════════
  SECTION 2: APP TRACKING TRANSPARENCY (ATT)
  ═══════════════════════════════════════════════
-->

<!-- ATT Permission Message - REQUIRED for iOS 14.5+ -->
<key>NSUserTrackingUsageDescription</key>
<string>We use your data to show you personalized ads and improve your experience. You can manage your preferences anytime in Settings.</string>
<!-- Dutch version:
<string>We gebruiken je gegevens om gepersonaliseerde advertenties te tonen en je ervaring te verbeteren. Je kunt je voorkeuren altijd beheren in Instellingen.</string>
-->

